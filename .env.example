# Your CODASMS reseller API key (get one at https://codasms.com/reseller).
# Required for the stdio server. Never commit your real key.
CODASMS_API_KEY=coda_live_xxxxxxxx

# Optional. Defaults to https://api.codasms.com — only change for testing.
# CODASMS_API_BASE=https://api.codasms.com

# Optional safety cap for the get_number tool, in US cents.
# If set, get_number refuses any number priced above this. Can also be passed per-call.
# CODASMS_MAX_PRICE_CENTS=200

# HTTP (remote) server only:
# PORT=8080
